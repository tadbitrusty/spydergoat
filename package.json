{
  "name": "spydergoat",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Server-derived MJD time API and React product site",
  "main": "src/api/worker.js",
  "scripts": {
    "dev": "npm run build && concurrently --kill-others --names web,worker \"npm:dev:web\" \"npm:dev:worker\"",
    "dev:web": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "test": "npm run test:worker && npm run test:web",
    "test:worker": "node --test test/*.test.js",
    "test:web": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && node --check src/api/worker.js && node --check src/billing/d1-repository.js && node --check src/billing/service.js && node --check src/billing/stripe.js",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "author": "Adam",
  "license": "MIT",
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
